# =============================================================================
# Xibo CMS Configuration
# Copy this file to config.env and fill in your values
# =============================================================================

# --- CMS Settings ---
CMS_SERVER_NAME=menus.poseztech.com
CMS_DEV_MODE=false
CMS_USE_MEMCACHED=true

# --- Database ---
MYSQL_DATABASE=cms
MYSQL_USER=cms
MYSQL_PASSWORD=CHANGE_ME_strong_password_here
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password_here

# --- CMS Admin Account ---
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=CHANGE_ME_admin_password_here

# --- CMS Key (used by players to connect) ---
CMS_KEY=CHANGE_ME_random_secret_key_here

# --- XMR (Xibo Message Relay) ---
XMR_HOST=cms-xmr

# --- Timezone ---
CMS_PHP_TIMEZONE=America/Chicago

# --- Upload Limits ---
CMS_PHP_POST_MAX_SIZE=2G
CMS_PHP_UPLOAD_MAX_FILESIZE=2G
CMS_PHP_MAX_EXECUTION_TIME=300

# --- Mail (optional, for notifications) ---
# CMS_PHP_MAIL_HOST=smtp.example.com
# CMS_PHP_MAIL_PORT=587
# CMS_PHP_MAIL_USERNAME=notifications@example.com
# CMS_PHP_MAIL_PASSWORD=smtp_password_here
# CMS_PHP_MAIL_FROM_ADDRESS=notifications@example.com
# CMS_PHP_MAIL_FROM_NAME=Xibo CMS

# --- Reverse Proxy ---
# Set to 1 if behind a reverse proxy
CMS_TRUST_PROXY=1
